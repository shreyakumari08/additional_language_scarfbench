<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="rsvp" transaction-type="JTA">
        <jta-data-source>mydb</jta-data-source>
        <class>helidon.tutorial.rsvp.entity.Event</class>
        <class>helidon.tutorial.rsvp.entity.Person</class>
        <class>helidon.tutorial.rsvp.entity.Response</class>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="create"/>
        </properties>
    </persistence-unit>
</persistence>
